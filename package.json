{
  "name": "cost-analysis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev:mem",
    "build": "tsc -b && vite build",
    "build:server": "npm --prefix server install --include=dev && npm --prefix server run build",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/dist/index.js",
    "seed": "npm --prefix server run seed",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "24.x"
  }
}
