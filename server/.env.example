PORT=4000
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/cost-analysis

# Login. Required in production — the server refuses to boot without them.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
