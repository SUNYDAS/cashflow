{
  "name": "cost-analysis-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "REST API for a personal income/expense tracker",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "dev:mem": "tsx watch src/dev-seeded.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.19.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
